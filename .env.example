# Optional server configuration. Copy to .env; never commit the real .env file.
DATABASE_PATH=.data/365.sqlite
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173

# Optional real password recovery email. Without SMTP, development writes .eml
# files into .data/mail. Production recovery requires SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_OUTBOX=.data/mail

# For public hosting, set NODE_ENV=production and APP_ORIGIN=https://your-domain.
# Put an HTTPS reverse proxy in front of the Node server. Use persistent storage
# for DATABASE_PATH and include SQLite WAL/SHM files in consistent backups.
